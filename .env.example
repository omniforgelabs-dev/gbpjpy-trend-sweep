# ═══════════════════════════════════════════════════════════════════════════
# GBP/JPY TREND SWEEP BOT — ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# Security Rule: Never commit real credentials to GitHub.
# In Render: Set these in Dashboard -> Service -> Environment -> Environment Variables.

# ── EXNESS API CREDENTIALS ──────────────────────────────────────────────────
# Your Exness API Key (starts with "exnsk-")
EXN_API_KEY=exnsk-your_api_key_here

# Your Exness Ed25519 Private Key (128-hex characters or PKCS#8 PEM string)
EXN_PRIVATE_KEY=your_128_hex_character_private_key_or_pem_here

# Your Exness Account Number (e.g. 12345678)
EXN_ACCOUNT_ID=your_exness_account_id_here

# Exness Gateway Discovery URL (standard: https://gateway.exness.com)
EXN_DISCOVERY_BASE_URL=https://gateway.exness.com

# ── DEMO / LIVE SWITCH ──────────────────────────────────────────────────────
# Set to "true" for Exness Demo testing.
# Set to "false" when switching to your real Exness Live account.
EXN_IS_DEMO=true

# ── RISK & EXECUTION PARAMETERS ─────────────────────────────────────────────
# Maximum intended risk per trade in USD (Default: $1.00 for ~$10 account balance)
MAX_RISK_USD=1.00

# Scanner cycle interval in milliseconds (Default: 60000 = 60 seconds)
POLL_INTERVAL_MS=60000

# Optional dry run mode ("true" to run in sandbox simulation without placing broker orders)
EXN_DRY_RUN=false
